generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STUDENT
  PROFESSOR
}

enum FormType {
  BW1A
  BW1B
  B1C
  B1D
  B2
  B3
  B4
  THESIS
  SIGNED
  FINANCE_DOC
  FINANCE_ATTACH
  EXAM_RESULT
  INVITE_LETTER
  VERY_GOOD_EVAL
}

enum ProgramType {
  PHD
  ME_MECH
  ME_CPS
}

enum SubmissionType {
  PROPOSAL
  THESIS_DEFENSE
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum SubmissionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passcodeHash String
  name         String
  roles          Role[]
  studentId      String?  @unique
  isProgramChair Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions        Submission[]   @relation("StudentSubmissions")
  advisorSubmissions Submission[]   @relation("AdvisorSubmissions")
  workflowSteps      WorkflowStep[]
  signatures         Signature[]
  uploads            FormUpload[]
  notifications      Notification[]

  @@map("users")
}

model Submission {
  id             String           @id @default(cuid())
  title          String
  submissionType SubmissionType?
  status         SubmissionStatus @default(DRAFT)
  adminNote      String?
  // Raw {name,email,role,phone}[] the student entered while status=DRAFT (some committee person
  // has no account yet); cleared once resolved and the real committee fields below are set.
  pendingPeople  Json?
  // Student-requested cancellation, pending ADMIN accept/decline — the submission's own `status`
  // does not change until then, and normal workflow actions are frozen while this is true.
  cancelRequested   Boolean   @default(false)
  cancelRequestedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student   User   @relation("StudentSubmissions", fields: [studentId], references: [id])
  studentId String

  // A THESIS_DEFENSE is created by importing committee/student info from a completed PROPOSAL.
  sourceProposal   Submission?  @relation("ProposalToDefense", fields: [sourceProposalId], references: [id])
  sourceProposalId String?
  defenses         Submission[] @relation("ProposalToDefense")

  advisor   User?   @relation("AdvisorSubmissions", fields: [advisorId], references: [id])
  advisorId String?

  studentFullName String?
  studentCode     String?
  program         ProgramType?
  studentEmail    String?
  studentPhone    String?

  headCommitteeId    String?
  committeeIds       String[]
  coAdvisorIds       String[]
  invitedCommitteeId String?
  programChairId     String?

  invitedProfName        String?
  invitedProfAffiliation String?
  invitedProfEmail       String?
  invitedProfPhone       String?

  examDate      String?
  examTime      String?
  roomNeeded    Boolean @default(false)
  parkingNeeded Boolean @default(false)
  carPlate      String?

  workflowSteps WorkflowStep[]
  uploads       FormUpload[]
  notifications Notification[]

  @@map("submissions")
}

model WorkflowStep {
  id          String     @id @default(cuid())
  stepOrder   Int
  role        String
  status      StepStatus @default(PENDING)
  notes       String?
  actedAt     DateTime?
  actedByName String?
  createdAt   DateTime   @default(now())

  committeeMembers String[]
  committeeActions Json?

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  actedBy   User?   @relation(fields: [actedById], references: [id])
  actedById String?

  signatures Signature[]

  @@unique([submissionId, stepOrder])
  @@map("workflow_steps")
}

model FormUpload {
  id         String   @id @default(cuid())
  formType   FormType
  fileUrl    String?
  fileName   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  @@map("form_uploads")
}

model Signature {
  id        String   @id @default(cuid())
  signedAt  DateTime @default(now())
  ipAddress String?

  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  workflowStepId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([workflowStepId, userId])
  @@map("signatures")
}

model MagicToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  redirectTo String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("magic_tokens")
}

// Fixed-window rate limiting for unauthenticated endpoints (register, forgot-password).
// DB-backed so the limit holds across serverless instances.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@map("rate_limits")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  detail    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  @@map("notifications")
}
