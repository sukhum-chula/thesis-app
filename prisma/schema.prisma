generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STUDENT
  PROFESSOR
  // กรรมการภายนอก — external examiner accounts. Functionally identical to PROFESSOR (same
  // login, same ability to be named on a submission's committee and sign documents), tagged
  // separately only so committee-picker dropdowns can offer "internal faculty" vs "external
  // examiner" as distinct lists. Created either directly by ADMIN via POST /api/users, or by
  // ADMIN approving a student's ExternalCommitteeRequest (see that model below).
  EXTERNAL
}

enum ExternalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FormType {
  BW1A
  BW1B
  B1C
  B1D
  B2
  B3
  B4
  THESIS
  SIGNED
  FINANCE_DOC
  FINANCE_ATTACH
  EXAM_RESULT
  INVITE_LETTER
  VERY_GOOD_EVAL
}

enum ProgramType {
  PHD
  ME_MECH
  ME_CPS
}

enum SubmissionType {
  PROPOSAL
  THESIS_DEFENSE
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum SubmissionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passcodeHash String
  name         String
  roles           Role[]
  studentId       String?      @unique
  // Meaningful mainly for EXTERNAL (กรรมการภายนอก) accounts — their institution, shown wherever
  // a submission displays its invited committee member. Harmless/unused for other roles.
  affiliation String?
  phone       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions        Submission[]   @relation("StudentSubmissions")
  advisorSubmissions Submission[]   @relation("AdvisorSubmissions")
  workflowSteps      WorkflowStep[]
  signatures         Signature[]
  uploads            FormUpload[]
  notifications      Notification[]

  // A STUDENT's requests to add a new กรรมการภายนอก (EXTERNAL) account — see
  // ExternalCommitteeRequest below. requestedExternalAccounts links back to the account actually
  // created once ADMIN approves one of this user's requests (via POST /api/users).
  externalRequestsMade   ExternalCommitteeRequest[] @relation("ExternalRequestsByStudent")
  externalRequestCreated ExternalCommitteeRequest?  @relation("ExternalRequestCreatedUser")

  @@map("users")
}

// A STUDENT-initiated request to add a new กรรมการภายนอก (external examiner) account — students
// can only pick existing accounts for a submission's committee, so this is the self-service path
// when the person they need isn't in the system yet. ADMIN reviews and either approves (creates
// the real User with role EXTERNAL via POST /api/users, which also links createdUserId back here)
// or rejects it. Independent of any specific submission — the resulting account can then be
// selected on any future proposal/defense.
model ExternalCommitteeRequest {
  id          String                @id @default(cuid())
  name        String
  email       String
  affiliation String?
  phone       String?
  status      ExternalRequestStatus @default(PENDING)
  reviewNote  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  requestedBy   User   @relation("ExternalRequestsByStudent", fields: [requestedById], references: [id])
  requestedById String

  createdUser   User?   @relation("ExternalRequestCreatedUser", fields: [createdUserId], references: [id])
  createdUserId String? @unique

  @@map("external_committee_requests")
}

model Submission {
  id             String           @id @default(cuid())
  title          String
  submissionType SubmissionType?
  status         SubmissionStatus @default(DRAFT)
  adminNote      String?
  // Raw {name,email,role,phone}[] the student entered while status=DRAFT (some committee person
  // has no account yet); cleared once resolved and the real committee fields below are set.
  pendingPeople  Json?
  // Student-requested cancellation, pending ADMIN accept/decline — the submission's own `status`
  // does not change until then, and normal workflow actions are frozen while this is true.
  cancelRequested   Boolean   @default(false)
  cancelRequestedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student   User   @relation("StudentSubmissions", fields: [studentId], references: [id])
  studentId String

  // A THESIS_DEFENSE is created by importing committee/student info from a completed PROPOSAL.
  sourceProposal   Submission?  @relation("ProposalToDefense", fields: [sourceProposalId], references: [id])
  sourceProposalId String?
  defenses         Submission[] @relation("ProposalToDefense")

  advisor   User?   @relation("AdvisorSubmissions", fields: [advisorId], references: [id])
  advisorId String?

  studentFullName String?
  studentCode     String?
  program         ProgramType?
  studentEmail    String?
  studentPhone    String?

  headCommitteeId    String?
  committeeIds       String[]
  coAdvisorIds       String[]
  invitedCommitteeId String?
  programChairId     String?

  invitedProfName        String?
  invitedProfAffiliation String?
  invitedProfEmail       String?
  invitedProfPhone       String?

  examDate      String?
  examTime      String?
  roomNeeded    Boolean @default(false)
  parkingNeeded Boolean @default(false)
  carPlate      String?

  workflowSteps WorkflowStep[]
  uploads       FormUpload[]
  notifications Notification[]

  @@map("submissions")
}

model WorkflowStep {
  id          String     @id @default(cuid())
  stepOrder   Int
  role        String
  status      StepStatus @default(PENDING)
  notes       String?
  actedAt     DateTime?
  actedByName String?
  createdAt   DateTime   @default(now())

  committeeMembers String[]
  committeeActions Json?

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  actedBy   User?   @relation(fields: [actedById], references: [id])
  actedById String?

  signatures Signature[]

  @@unique([submissionId, stepOrder])
  @@map("workflow_steps")
}

model FormUpload {
  id         String   @id @default(cuid())
  formType   FormType
  fileUrl    String?
  fileName   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  @@map("form_uploads")
}

model Signature {
  id        String   @id @default(cuid())
  signedAt  DateTime @default(now())
  ipAddress String?

  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  workflowStepId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([workflowStepId, userId])
  @@map("signatures")
}

model MagicToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  redirectTo String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("magic_tokens")
}

// Fixed-window rate limiting for unauthenticated endpoints (register, forgot-password).
// DB-backed so the limit holds across serverless instances.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@map("rate_limits")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  detail    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String

  // Nullable — some notifications (e.g. ExternalCommitteeRequest review) aren't about a
  // submission at all. NotificationBell already falls back to the recipient's landing page
  // when this is null.
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String?

  @@map("notifications")
}

// Admin-designated single-holder-per-key assignments that used to live as columns directly on
// User (programChairFor per ProgramType, isFinanceContact) — moved into their own table so
// account records don't carry system-configuration state. `key` identifies the setting:
//   "programChair:PHD" | "programChair:ME_MECH" | "programChair:ME_CPS" | "financeContact"
// `userId` is the designated user's id — validated against User in application code
// (src/lib/systemSettings.ts), not enforced as a DB-level foreign key. The row itself is never
// deleted once created: clearing an assignment (or the holder's account being deleted) sets
// `userId` to null instead, so the key always stays present in the table. Each key holds at most
// one user, but the same user id may appear under multiple "programChair:*" keys — one professor
// can chair several programs at once (see setProgramChair() in systemSettings.ts).
model SystemSetting {
  key       String   @id
  userId    String?
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
